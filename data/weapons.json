// Prototype weapons, named by units.json. Every field, its units and its default: docs/data.md.
// "against": times the damage on infantry, vehicles (defenses too) and structures; small arms barely
// scratch armor, so vehicles fall to cannon and rockets.
{
  "rifle": { "kind": "bullet", "damage": 1, "reload": 0.5, "range": 8, "against": { "vehicle": 0.15, "structure": 0.3 }, "prefers": "infantry" }, // 2 dps a member
  "machine_gun": { "kind": "bullet", "damage": 1.35, "reload": 0.15, "range": 12, "against": { "vehicle": 0.2, "structure": 0.3 }, "prefers": "infantry" }, // 9 dps
  "turret_gun": { "kind": "bullet", "damage": 2, "reload": 0.2, "range": 13, "against": { "vehicle": 0.2, "structure": 0.3 }, "prefers": "infantry" }, // 10 dps; tanks outrange it
  "turret_cannon": { "kind": "shell", "hit": "direct", "damage": 45, "reload": 3, "range": 15, "shellSpeed": 45, "prefers": "vehicle" }, // 15 dps on vehicles; a squad loses one member a hit
  "tank_cannon": { "kind": "shell", "hit": "direct", "damage": 42, "reload": 3, "range": 14, "shellSpeed": 40, "against": { "structure": 1.5 }, "prefers": "vehicle" }, // 14 dps, in big hits
  "rocket": { "kind": "shell", "hit": "direct", "damage": 15, "reload": 3, "range": 13, "shellSpeed": 30, "against": { "infantry": 0.5 }, "prefers": "vehicle" }, // 5 dps a member; a volley at a squad doesn't fell even one
  "artillery_gun": { "kind": "shell", "hit": "splash", "damage": 30, "splashRadius": 3.5, "reload": 5, "range": 28,
                     "minRange": 8, "shellSpeed": 22, "ballistic": true, "scatter": 3, "against": { "vehicle": 0.5, "structure": 3 }, "prefers": "infantry" }, // 6 dps, slow, lands near the aim; 18 on buildings
}
