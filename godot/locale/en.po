# --- Packages panel
msgid "packages.label"
msgstr "PACKAGES"

msgid "packages.rate"
msgstr "+{0}/min"

# {0} the income window, s
msgid "packages.tip"
msgstr "Packages to spend. Your depots unload them from passing trucks, and your units pick up what destroyed trucks spill.\n+N/min: what you took per minute over the last {0} s"

# --- Command card
msgid "card.repeat.tip"
msgstr "{0}: each finished unit goes back to the end of the queue, so a mix keeps its ratio"

# A foundation: {0} building, {1} percent done, {2} its state
msgid "card.site"
msgstr "{0} {1}%, {2}"

msgid "card.site.stalled"
msgstr "stalled: not enough packages"

msgid "card.site.building"
msgstr "building"

msgid "card.site.waiting"
msgstr "waiting for a builder"

# A cell of the command grid (its key is drawn in its corner): {0} name, {1} cost
msgid "card.cell"
msgstr "{0}\n{1}"

msgid "card.attack_move"
msgstr "Attack\nmove"

msgid "card.attack_move.tip"
msgstr "Then click where to go: they fight whatever they meet on the way. Click an enemy to attack it."

msgid "card.stop"
msgstr "Stop"

msgid "card.stop.tip"
msgstr "Drop every order and stand. They still shoot what comes in range, and answer fire."

msgid "card.hold"
msgstr "Hold"

msgid "card.hold.tip"
msgstr "Hold this spot: shoot what comes in range, never chase, never give way. On a road, trucks can't pass."

msgid "card.rotate"
msgstr "Rotate"

msgid "card.rotate.tip"
msgstr "Turn the building being placed a quarter turn."

msgid "card.repeat.on"
msgstr "Repeat\non"

msgid "card.repeat.off"
msgstr "Repeat\noff"

# The queued count in a cell's corner: {0} how many
msgid "card.queued"
msgstr "×{0}"

msgid "card.stalled"
msgstr "stalled"

# {0} unit, {1} cost, {2} build time s, {3} its key, {4} the cancel-last key
msgid "card.train.tip"
msgstr "{0}: {1} packages, {2} s, paid as it trains\n{3} or click: train one   RMB: cancel one   {4}: cancel the last\nRMB the ground: set the rally point"

# {0} cost, {1} how much is missing
# A build cell's tooltip, first line, while what it needs is missing: {0} that building
msgid "card.requires"
msgstr "Needs a {0} first."

msgid "card.short"
msgstr "{0} ({1} short)"

# {0} building, {1} cost, {2} build time s, {3} what it is, {4} its key, {5} the rotate key
msgid "card.build.tip"
msgstr "{0}: {1} packages, {2} s. {3}\nStarting one needs the whole cost in hand; it's paid as it grows\n{4} or click: place it   Shift: place more   {5}: rotate   RMB/Esc: cancel\nRMB your unfinished foundation: build it"

